@{
    ViewData["Title"] = "Сотрудники";
}
@model Employees.Models.ViewModels.EmployeesListViewModel
@{
    var paging = Model.Page;
    var selectedStatus = Model.Status;

    var firstPageNumber = Math.Max(1, paging.Page - 3);
    var lastPageNumber = Math.Min(paging.TotalPages, firstPageNumber + 6);
    firstPageNumber = Math.Max(1, lastPageNumber - 6);

    string DateOrDash(DateTime? value) => value?.ToString("dd.MM.yyyy") ?? "—";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Сотрудники</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btnAdd">Добавить сотрудника</button>
        <button type="button" class="btn btn-outline-primary" id="btnEdit" disabled>Изменить сотрудника</button>
        <button type="button" class="btn btn-outline-danger" id="btnDelete" disabled>Удалить</button>
    </div>
</div>

<form method="get" asp-controller="Employees" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-4">
            <label class="form-label mb-1" for="search">ФИО</label>
            <input type="text" class="form-control" id="search" name="search" value="@Model.Search"
                   placeholder="например, Иванов" />
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label mb-1" for="status">Статус</label>
            <select class="form-select" id="status" name="status">
                <option value="all" selected="@(selectedStatus == "all" ? "selected" : null)">Все</option>
                <option value="active" selected="@(selectedStatus == "active" ? "selected" : null)">Трудоустроенные</option>
                <option value="terminated" selected="@(selectedStatus == "terminated" ? "selected" : null)">Уволенные</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label class="form-label mb-1" for="pageSize">Записей на странице</label>
            <input type="number" class="form-control" id="pageSize" name="pageSize"
                   value="@paging.PageSize" min="1" max="@EmployeeService.MaxPageSize" />
        </div>
        <div class="col-sm-6 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-secondary flex-grow-1">Применить фильтр</button>
            <a class="btn btn-outline-secondary" asp-controller="Employees" asp-action="Index"
               title="Очистить фильтр">Очистить фильтр</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 60px;"></th>
                    <th scope="col">ID</th>
                    <th scope="col">ФИО</th>
                    <th scope="col">Дата рождения</th>
                    <th scope="col">Дата трудоустройства</th>
                    <th scope="col">Дата увольнения</th>
                    <th scope="col">Активность</th>
                </tr>
            </thead>
            <tbody id="employeesBody">
                @if (paging.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Сотрудники не найдены</td>
                    </tr>
                }
                else
                {
                    foreach (var e in paging.Items)
                    {
                        var rowClass = e.IsActive ? string.Empty : "table-secondary";
                        <tr data-id="@e.Id" class="employee-row @rowClass">
                            <td>
                                <input type="radio" name="selectedId" class="form-check-input row-select"
                                       value="@e.Id" aria-label="Выбрать сотрудника @e.Id" />
                            </td>
                            <td>@e.Id</td>
                            <td class="fw-semibold">@e.FullName</td>
                            <td>@DateOrDash(e.BirthDate)</td>
                            <td>@DateOrDash(e.HireDate)</td>
                            <td>@DateOrDash(e.DismissDate)</td>
                            <td>
                                @if (e.IsActive)
                                {
                                    <span class="badge text-bg-success">Активен</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Неактивен</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">
        Найдено: <strong>@paging.Total</strong>
        @if (paging.TotalPages > 1)
        {
            <span>· страница @paging.Page из @paging.TotalPages</span>
        }
    </span>

    <nav aria-label="Навигация по страницам">
        <ul class="pagination mb-0">
            <li class="page-item @(paging.HasPrevious ? string.Empty : "disabled")">
                <a class="page-link" asp-controller="Employees" asp-action="Index"
                   asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                   asp-route-pageSize="@paging.PageSize"
                   asp-route-page="@(paging.HasPrevious ? paging.Page - 1 : 1)">Назад</a>
            </li>

            @for (var p = firstPageNumber; p <= lastPageNumber; p++)
            {
                var pageNumber = p;
                <li class="page-item @(pageNumber == paging.Page ? "active" : string.Empty)">
                    <a class="page-link" asp-controller="Employees" asp-action="Index"
                       asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                       asp-route-pageSize="@paging.PageSize"
                       asp-route-page="@pageNumber">@pageNumber</a>
                </li>
            }

            <li class="page-item @(paging.HasNext ? string.Empty : "disabled")">
                <a class="page-link" asp-controller="Employees" asp-action="Index"
                   asp-route-search="@Model.Search" asp-route-status="@Model.Status"
                   asp-route-pageSize="@paging.PageSize"
                   asp-route-page="@(paging.HasNext ? paging.Page + 1 : paging.TotalPages)">Вперёд</a>
            </li>
        </ul>
    </nav>
</div>

<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="employeeModalTitle">Добавление сотрудника</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="modalError"></div>

                <input type="hidden" id="fieldId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="fieldLastName">Фамилия</label>
                        <input type="text" class="form-control" id="fieldLastName" maxlength="50" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="fieldFirstName">Имя</label>
                        <input type="text" class="form-control" id="fieldFirstName" maxlength="50" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="fieldMiddleName">Отчество</label>
                        <input type="text" class="form-control" id="fieldMiddleName" maxlength="50" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="fieldBirthDate">Дата рождения</label>
                        <input type="date" class="form-control" id="fieldBirthDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="fieldHireDate">Дата трудоустройства</label>
                        <input type="date" class="form-control" id="fieldHireDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="fieldDismissDate">Дата увольнения</label>
                        <input type="date" class="form-control" id="fieldDismissDate" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="fieldIsActive" checked />
                            <label class="form-check-label" for="fieldIsActive">Активен</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnSave">Сохранить</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/employees.js" asp-append-version="true"></script>
}